.env
.env.local
__pycache__/
*.pyc
venv/
logs/
node_modules/

# 阶段三：ChromaDB 持久化目录（本地数据，不入库）
chroma_db/

# pip 临时目录/缓存（torch 体积大，需放在真实磁盘而非沙箱 tmpfs）
.piptmp/
.pipcache/

# HuggingFace 模型缓存（本机无法直连 huggingface.co，走 hf-mirror 镜像）
.hf_cache/

# 工具缓存（不应入库）
.cachebro/
.omo/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# 测试/验收脚本的落盘产物
backend/logs/
backend/chroma_db/
*.tmp
.env.*
!.env.example

# npm 缓存（本机 ~/.npm 只读，需重定向到仓库内）
.npmcache/

# Playwright 浏览器与产物（本机 ~/.cache 只读，需重定向到仓库内）
.playwright/
frontend/test-results/
frontend/playwright-report/

# 前端构建产物（源码入库、产物不入库）
frontend/dist/
