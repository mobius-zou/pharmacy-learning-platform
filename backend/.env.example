# 药学学习平台 —— 后端环境变量示例
#
# 用法：复制本文件为 backend/.env，填入真实值。
#   cp backend/.env.example backend/.env
#
# 注意：backend/.env 由使用者自行维护，已被 .gitignore 忽略，
#      请勿把真实密码、密钥提交到版本库。

# ---------- 数据库（必填）----------
# 格式：mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://pharmacy_user:CHANGE_ME@127.0.0.1:3306/pharmacy_db?charset=utf8mb4

# ---------- 认证（强烈建议填写）----------
# 未配置时后端会生成进程内临时密钥，重启后所有 token 失效。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---------- FSRS 调度 ----------
# 目标保留率：0.9 表示希望用户有 90% 的概率能回忆起来
FSRS_DESIRED_RETENTION=0.9
# 是否对间隔施加随机扰动（避免同一天的卡片长期扎堆）
FSRS_ENABLE_FUZZING=true
FSRS_MAXIMUM_INTERVAL=36500

# ---------- 日志 ----------
LOG_LEVEL=INFO
# LOG_FILE=/absolute/path/to/backend/logs/app.log

# ---------- 应用 ----------
CORS_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12

# ---------- 安全与限流 ----------
# 登录失败限流（进程内滑动窗口）。多 worker 时实际阈值约为 配置值 × worker 数
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=300
# 请求体大小上限（字节）；multipart 上传走各端点自己的上限
MAX_REQUEST_BODY_BYTES=2097152
# 文本文件导入上限（字节）
MAX_TEXT_FILE_BYTES=5242880

# ---------- 错题诊断（阶段二）----------
# 同一知识点「累计错误次数」达到该阈值即触发薄弱点警报
WEAK_POINT_THRESHOLD=2

# ---------- LLM（可选：知识点识别 + 苏格拉底式提问）----------
# 不配置时自动进入「无 Agent 降级模式」：使用本地启发式规则，
# 错题录入、薄弱点警报、复习调度全部照常工作。
# 实现仅使用 Python 标准库调用 OpenAI 兼容接口，不引入任何新依赖。
# LLM_API_BASE=https://api.example.com/v1
# LLM_API_KEY=CHANGE_ME
# LLM_MODEL=your-model-name
# LLM_TIMEOUT_SECONDS=15

# ---------- 测试（可选）----------
# 仅供 pytest 使用；不填写时测试会自动从 DATABASE_URL 派生 <dbname>_test。
# TEST_DATABASE_URL=mysql+pymysql://pharmacy_user:CHANGE_ME@127.0.0.1:3306/pharmacy_db_test

# ---------- 文献工作台（阶段三）----------
# ChromaDB 持久化目录：存放文献向量与「待人工校对」草稿
# CHROMA_DIR=/absolute/path/to/backend/chroma_db
# 离线确定性嵌入维度（字符/词 n-gram 哈希，不下载模型、不联网）
EMBEDDING_DIM=256

# PubMed E-utilities（api_key 与 email 可选，用于提高速率上限）
# PUBMED_API_KEY=CHANGE_ME
# PUBMED_EMAIL=you@example.com
PUBMED_TOOL=pharmacy-learning-platform
PUBMED_TIMEOUT_SECONDS=20

# 单篇文献最多确认入库的三元组数量（防止抽取结果爆炸）
KG_MAX_TRIPLES=80

# ---------- 考点匹配（阶段五）----------
# 匹配打分：最终分 = 语义相似度 * SEMANTIC_WEIGHT + 编辑距离相似度 * EDIT_WEIGHT
EXAM_MATCH_SEMANTIC_WEIGHT=0.6
EXAM_MATCH_EDIT_WEIGHT=0.4
# 低于该分数视为「未匹配」
EXAM_MATCH_MIN_SCORE=0.42
# 编辑距离初筛保留的候选数（语义精筛只在这些候选上做）
EXAM_MATCH_PREFILTER_LIMIT=30
# 一次导入最多处理的考点数
EXAM_MAX_POINTS_PER_IMPORT=200
# FSRS 稳定性达到该值（天）且无历史错误 => 视为「已掌握」（确认考点）
EXAM_MASTERED_STABILITY=21.0

# sentence-transformers 语义精筛（不装也能用：自动降级为编辑距离 + 离线哈希嵌入）
ST_ENABLED=true
# 启动时后台预热嵌入模型，避免首个匹配请求同步等十几秒（异步，不阻塞启动）
ST_WARMUP_ON_STARTUP=true
ST_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# 离线环境设为 false，可避免尝试联网下载模型
ST_ALLOW_DOWNLOAD=true

# HuggingFace 模型缓存与镜像。
# 本机无法直连 huggingface.co，默认走 hf-mirror.com 镜像；
# 使用官方源请设为 https://huggingface.co。
HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=/absolute/path/to/.hf_cache
